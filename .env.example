# Copier ce fichier en « .env » pour surcharger les valeurs par defaut :
#
#     cp .env.example .env
#
# docker-compose.yml lit automatiquement le fichier .env situe a cote de lui.
# Chaque variable y est declaree sous la forme ${NOM:-valeur_par_defaut}, si
# bien que « docker compose up » fonctionne meme sans .env : c'est ce qui
# permet a une machine vierge de demarrer le projet sans etape prealable.
#
# .env est ignore par git (voir .gitignore) : les mots de passe reels ne
# doivent jamais etre versionnes. Les valeurs ci-dessous sont des valeurs de
# developpement, publiques par construction, et ne conviennent pas a un
# deploiement.

POSTGRES_DB=bibliotheque
POSTGRES_USER=bibliotheque
POSTGRES_PASSWORD=bibliotheque
