            "description": "ANNULEE est un statut terminal : RG-06 interdit toute transition ulterieure."
          }
        },
        {
          "name": "4.9 RG-03 - apres annulation, A2 peut reserver L5 -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
