                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"livreId\": {{L1}},\n  \"adherentId\": {{A1}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/reservations", "host": ["{{baseUrl}}"], "path": ["api", "reservations"] },
            "description": "L1 est en rayon : une reservation n'a pas lieu d'etre, il faut l'emprunter."
          }
        },
        {
          "name": "4.2 RG-03 (1/4) - A2 reserve L2 -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Deux adherents peuvent reserver le meme livre', function () {",
                  "    pm.expect(pm.response.json().livreId).to.eql(202);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"livreId\": {{L2}},\n  \"adherentId\": {{A2}}\n}" },
