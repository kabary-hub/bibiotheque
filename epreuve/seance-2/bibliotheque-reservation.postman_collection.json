          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/borrow/book/{{L2}}", "host": ["{{baseUrl}}"], "path": ["borrow", "book", "{{L2}}"] },
            "description": "Qui a emprunte L2, et quand."
          }
        }
      ]
    },
    {
      "name": "3 - Parcours nominal",
      "item": [
        {
          "name": "3.1 POST - A1 reserve L2 -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('reservationA1', r.id);",
                  "",
                  "pm.test('Statut initial EN_ATTENTE', function () {",
                  "    pm.expect(r.statut).to.eql('EN_ATTENTE');",
                  "});",
                  "pm.test('RG-04 : echeance exactement a sept jours', function () {",
                  "    const debut = new Date(r.dateReservation);",
                  "    const fin = new Date(r.dateExpiration);",
                  "    pm.expect((fin - debut) / 86400000).to.eql(7);",
                  "});",
                  "pm.test('Le serveur a horodate lui-meme', function () {",
                  "    pm.expect(r.dateReservation).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('La reponse est un DTO, pas l entite', function () {",
                  "    pm.expect(r).to.have.all.keys('id', 'livreId', 'livreTitre', 'adherentId', 'adherentNom', 'dateReservation', 'dateExpiration', 'statut');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"livreId\": {{L2}},\n  \"adherentId\": {{A1}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/reservations", "host": ["{{baseUrl}}"], "path": ["api", "reservations"] },
            "description": "Le client n'envoie que livreId et adherentId. Les deux dates et le statut viennent du serveur."
          }
        },
        {
          "name": "3.2 GET /api/reservations/{{reservationA1}} - consulter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('C est bien la reservation creee', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.id).to.eql(Number(pm.collectionVariables.get('reservationA1')));",
                  "    pm.expect(r.livreId).to.eql(202);",
                  "    pm.expect(r.adherentId).to.eql(301);",
                  "});"
                ]
              }
            }
