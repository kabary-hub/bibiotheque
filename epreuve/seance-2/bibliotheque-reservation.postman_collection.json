                  "pm.test('Cette route n exige que d etre authentifie', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA1}}" }],
            "url": { "raw": "{{baseUrl}}/admin/books", "host": ["{{baseUrl}}"], "path": ["admin", "books"] },
