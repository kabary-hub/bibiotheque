          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/reservations/{{reservationA1}}", "host": ["{{baseUrl}}"], "path": ["api", "reservations", "{{reservationA1}}"] },
            "description": "L'identifiant vient de 3.1, range automatiquement dans {{reservationA1}}."
          }
        },
        {
          "name": "3.3 GET /api/reservations - lister",
          "event": [
