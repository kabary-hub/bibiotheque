          "name": "6.1 GET /admin/users SANS jeton -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"]
              }
            }
