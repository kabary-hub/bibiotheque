          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] },
            "description": "401 : la requete n'est pas authentifiee du tout."
          }
        },
        {
          "name": "6.2 GET /admin/users avec le jeton de A1 -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });",
                  "pm.test('403 et non 401 : A1 est authentifie, mais pas Admin', function () {",
                  "    pm.expect(pm.response.code).to.not.eql(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA1}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] },
            "description": "La double protection du projet : la chaine de filtres authentifie, @PreAuthorize verifie le role. Etre connecte ne suffit pas. Le jeton vient de 1.2."
          }
        },
